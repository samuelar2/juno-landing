---
// Pass `shot` (path under /screens/) to show a real app screenshot;
// otherwise the slot renders a hand-built mock screen.
const { class: className = "", shot = "", alt = "The osmos app" } = Astro.props;
---

<div class={`phone ${className}`}>
  <div class="phone-island"></div>
  <div class="phone-screen">
    {shot ? <img class="phone-shot" src={shot} alt={alt} loading="lazy" /> : <slot />}
  </div>
</div>
