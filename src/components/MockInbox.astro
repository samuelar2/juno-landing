---
// Inbox mockup: triaged list with a drafted reply.
const rows = [
  {
    from: "Amelia Ross",
    subject: "Contract — final signature needed",
    tag: "Needs reply",
    tagClass: "bg-rose-500/25 text-rose-200",
    note: "Draft ready",
  },
  {
    from: "British Airways",
    subject: "Your flight BA432 is confirmed",
    tag: "Filed to Wallet",
    tagClass: "bg-[#6d4aff]/25 text-[#c9b8ff]",
  },
  {
    from: "Jonas (Landlord)",
    subject: "Re: deposit return",
    tag: "Needs reply",
    tagClass: "bg-rose-500/25 text-rose-200",
    note: "Draft ready",
  },
  {
    from: "Substack Digest",
    subject: "12 newsletters, summarised",
    tag: "Low priority",
    tagClass: "bg-white/10 text-white/50",
  },
];
---

<div class="flex h-full flex-col px-4 pt-14 pb-6">
  <div class="flex items-baseline justify-between">
    <span class="display text-[19px] font-bold text-white">inbox</span>
    <span class="text-[11px] font-medium text-[#c9b8ff]">2 need you · rest handled</span>
  </div>

  <div class="mt-3 flex flex-col gap-2">
    {
      rows.map((r) => (
        <div class="glass rounded-xl px-3 py-2.5 text-[12px]">
          <div class="flex items-center justify-between">
            <span class="font-semibold text-white">{r.from}</span>
            <span class={`rounded-full px-2 py-0.5 text-[9.5px] font-semibold ${r.tagClass}`}>{r.tag}</span>
          </div>
          <div class="mt-0.5 truncate text-white/60">{r.subject}</div>
          {r.note && (
            <div class="mt-1.5 flex items-center gap-1.5 text-[10.5px] font-semibold text-emerald-300">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-300" />
              {r.note} — tap to review &amp; send
            </div>
          )}
        </div>
      ))
    }
  </div>

  <div class="glass-bright mt-auto rounded-xl px-3 py-2.5 text-[11px] text-white/70">
    <span class="font-semibold text-white">sam@osmos…</span> chased the venue about Saturday —
    <span class="text-[#c9b8ff]">reply came in, table booked.</span>
  </div>
</div>
